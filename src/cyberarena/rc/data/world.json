{
  "version": "hp-2",
  "company": {
    "name": "Harlow & Pine Logistics",
    "short": "Harlow & Pine",
    "about": "An invented mid-size logistics firm: about 220 employees, one head office, two depots (north and south). Payroll runs every other Friday.",
    "fictional": true
  },
  "zones": [
    {"id": "edge", "label": "Edge (internet-facing)"},
    {"id": "office", "label": "Office and depot computers"},
    {"id": "servers", "label": "Internal servers"},
    {"id": "core", "label": "Core systems"},
    {"id": "security", "label": "Security tooling"}
  ],
  "hosts": [
    {"name": "web-01", "zone": "edge", "role": "public tracking website", "dept": "Sales", "custodian": "z.laurent", "crit": 3, "os": "server", "users": ["svc-web"], "profile": "Serves the public parcel-tracking site; content sync from files-01 at 03:00 by svc-web."},
    {"name": "vpn-01", "zone": "edge", "role": "remote-access gateway", "dept": "IT", "custodian": "d.roy", "crit": 4, "os": "appliance", "users": [], "profile": "Remote sign-ins for staff working away from the office; a few per night."},
    {"name": "mail-01", "zone": "edge", "role": "mail and ticket gateway", "dept": "IT", "custodian": "l.chen", "crit": 3, "os": "server", "users": ["svc-sync"], "profile": "Receives mail and helpdesk tickets around the clock."},
    {"name": "ws-fin-01", "zone": "office", "role": "finance laptop", "dept": "Finance", "custodian": "l.brandt", "crit": 2, "os": "desktop", "users": ["l.brandt", "o.nilsen", "g.odum"], "profile": "Office hours use; idle at night apart from updates."},
    {"name": "ws-fin-02", "zone": "office", "role": "payroll laptop", "dept": "Finance", "custodian": "m.tanaka", "crit": 2, "os": "desktop", "users": ["m.tanaka", "f.haddad"], "profile": "Prepares the payroll batch; busy on payroll Fridays."},
    {"name": "ws-hr-01", "zone": "office", "role": "HR laptop", "dept": "HR", "custodian": "r.ibarra", "crit": 2, "os": "desktop", "users": ["r.ibarra", "s.achebe", "i.moreau"], "profile": "Office hours use; opens CVs and forms from mail."},
    {"name": "ws-ops-01", "zone": "office", "role": "operations desktop (head office)", "dept": "Operations", "custodian": "s.lindqvist", "crit": 1, "os": "desktop", "users": ["s.lindqvist", "b.hollis", "p.zielinski"], "profile": "Route planning; used by the night planners."},
    {"name": "ws-ops-02", "zone": "office", "role": "dispatch desktop (north depot)", "dept": "Operations", "custodian": "j.pereira", "crit": 1, "os": "desktop", "users": ["j.pereira", "k.mori", "y.khalil"], "profile": "Night dispatch; busy around the shift change."},
    {"name": "ws-ops-03", "zone": "office", "role": "dispatch desktop (south depot)", "dept": "Operations", "custodian": "a.diallo", "crit": 1, "os": "desktop", "users": ["a.diallo", "l.ferri"], "profile": "Night dispatch; busy around the shift change."},
    {"name": "ws-dev-01", "zone": "office", "role": "developer workstation", "dept": "IT", "custodian": "e.dahl", "crit": 2, "os": "desktop", "users": ["e.dahl", "s.russo"], "profile": "Builds the tracking site; runs test jobs at night."},
    {"name": "hr-portal", "zone": "servers", "role": "internal HR web app", "dept": "HR", "custodian": "r.ibarra", "crit": 3, "os": "server", "users": ["svc-payroll"], "profile": "Staff records and payslips; reads the payroll database through svc-payroll."},
    {"name": "files-01", "zone": "servers", "role": "shared drives", "dept": "IT", "custodian": "l.chen", "crit": 3, "os": "server", "users": ["svc-backup", "svc-web"], "profile": "Department shares; backed up nightly by svc-backup."},
    {"name": "print-01", "zone": "servers", "role": "print server", "dept": "Facilities", "custodian": "m.singh", "crit": 1, "os": "server", "users": ["svc-print"], "profile": "Depot label printers; noisy, harmless failed sign-ins from old printers."},
    {"name": "dc-01", "zone": "core", "role": "identity and directory server", "dept": "IT", "custodian": "m.ivers", "crit": 5, "os": "server", "users": ["svc-sync", "adm-ivers", "adm-chen", "adm-roy"], "profile": "Every sign-in in the company goes through it."},
    {"name": "db-01", "zone": "core", "role": "customer database", "dept": "Sales", "custodian": "f.wagner", "crit": 5, "os": "server", "users": ["svc-backup", "svc-web"], "profile": "Customer and shipment records; nightly backup to backup-01 by svc-backup."},
    {"name": "db-02", "zone": "core", "role": "payroll database", "dept": "Finance", "custodian": "m.tanaka", "crit": 5, "os": "server", "users": ["svc-payroll", "svc-backup"], "profile": "Payroll; the payroll batch runs here on payroll Fridays."},
    {"name": "backup-01", "zone": "core", "role": "backup server", "dept": "IT", "custodian": "a.nwosu", "crit": 4, "os": "server", "users": ["svc-backup"], "profile": "Pulls nightly copies of db-01, db-02 and files-01; large transfers at night are normal."},
    {"name": "monitor-01", "zone": "security", "role": "security monitoring (the alert source)", "dept": "IT", "custodian": "o.farouk", "crit": 4, "os": "appliance", "users": ["svc-scan"], "profile": "Collects logs and raises every alert you see. If it is offline, no new alerts arrive."}
